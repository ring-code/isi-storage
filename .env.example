######################################################
#                     ATTENTION                      #
######################################################
# use setup.py to setup the actual .env file safely: python3 setup_env.py
# this is just an example file for documentation and to keep track if you make changes to env vars/the setup_env script
# the real .env file should never be tracked!
# if you committed/pushed a production secret, switch it instantly and restart the service
# you can check with this if youre unsure:
# git ls-files | grep .env
# if its there, remove from cache: git rm --cached .env

# default admin credentials
DEFAULT_ADMIN_EMAIL=admin@test.com
DEFAULT_ADMIN_USER=admin

# The base URL of the WordPress installation's REST API. Can be empty to turn off polling
WP_API_BASE_URL=https://your-wp-domain.com/wp-json/isi/v1
# needed for optional seperate frontend
CORS_ORIGINS=https://storage.your-internal-domain.com

# These never need to change
POSTGRES_USER=isidb_user
POSTGRES_DB=storage_db


